<!DOCTYPE html>
<html lang="th"><head><meta charset="utf-8"><title>Salon Pro - จองคิวร้าน+ถึงบ้าน</title>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Prompt:wght@400;600;800&family=Kanit:wght@400;600;800&family=Chakra+Petch:wght@400;600;700&family=Sarabun:wght@400;600;800&family=Mitr:wght@400;600&family=Noto+Sans+Thai:wght@400;600;800&display=swap">
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<style>
:root{color-scheme:light;--bg:#faf7f5;--cd:#fff;--tx:#2a2227;--mu:#7b6f76;--ac:#c2456b;--ln:#eadfe3;--ok:#1d8a5a;--wr:#b36b00;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){color-scheme:dark;--bg:#1b1619;--cd:#272024;--tx:#f3eaee;--mu:#a89aa1;--ac:#ec6f94;--ln:#3a2f35;--ok:#4cc790;--wr:#f0b252}}
:root[data-theme="dark"]{color-scheme:dark;--bg:#1b1619;--cd:#272024;--tx:#f3eaee;--mu:#a89aa1;--ac:#ec6f94;--ln:#3a2f35;--ok:#4cc790;--wr:#f0b252}
*{box-sizing:border-box}html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:auto;background:var(--bg);color:var(--tx);font:15px/1.5 "Noto Sans Thai",system-ui,sans-serif;max-width:560px;padding-bottom:84px}
header{display:flex;align-items:center;gap:10px;padding:14px 16px}header img{width:44px;height:44px;border-radius:50%;object-fit:cover;background:var(--ln)}
h1{font-size:18px;margin:0}h2{font-size:16px;margin:0 0 8px}
nav{position:fixed;bottom:0;left:0;right:0;max-width:560px;margin:auto;display:flex;background:var(--cd);border-top:1px solid var(--ln);padding-bottom:env(safe-area-inset-bottom,0px)}
nav button{flex:1;border:0;background:none;color:var(--mu);padding:12px 2px;font:inherit;font-size:12px}nav button.on{color:var(--ac);font-weight:700}
.c{background:var(--cd);border:1px solid var(--ln);border-radius:14px;padding:14px;margin:0 12px 12px}
input,select{font:inherit;color:var(--tx);background:var(--bg);border:1px solid var(--ln);border-radius:10px;padding:9px 10px;width:100%;margin:4px 0}
input[type=checkbox]{width:auto;margin:3px 8px 0 0}
button.b{font:inherit;background:var(--ac);color:#fff;border:0;border-radius:10px;padding:9px 10px;width:100%;margin:4px 0;font-weight:600;cursor:pointer}
button.b.s{background:var(--bg);color:var(--tx);border:1px solid var(--ln)}button.b:disabled{opacity:.4}
.r{display:flex;gap:8px;align-items:center}.r>*{flex:1}.r>.f{flex:0 0 auto}
.sl{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin:6px 0}
.sl button{padding:8px 0;border-radius:8px;border:1px solid var(--ln);background:var(--bg);color:var(--tx);font:inherit}
.sl button.on{background:var(--ac);color:#fff;border-color:var(--ac)}.sl button:disabled{opacity:.3;text-decoration:line-through}
.mu{color:var(--mu);font-size:13px}.ok{color:var(--ok)}.wr{color:var(--wr)}.tag{font-size:12px;padding:2px 8px;border-radius:99px;background:var(--ln)}
table{width:100%;border-collapse:collapse;font-size:13px}td,th{padding:6px 4px;border-bottom:1px solid var(--ln);text-align:left}.sc{overflow-x:auto}
.q{text-align:center}.q div{display:inline-block;background:#fff;padding:10px;border-radius:10px}
#toast{position:fixed;top:calc(12px + env(safe-area-inset-top,0px));left:12px;right:12px;max-width:536px;margin:auto;background:#06c755;color:#fff;padding:10px 14px;border-radius:12px;display:none;z-index:9}
h1,h2{letter-spacing:.3px}h1{background:linear-gradient(90deg,var(--tx),var(--ac));-webkit-background-clip:text;background-clip:text;color:transparent}
.c{background:color-mix(in srgb,var(--cd) 72%,transparent);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);border:1px solid color-mix(in srgb,var(--ac) 35%,transparent);border-radius:18px;box-shadow:0 8px 30px rgba(0,0,0,.22)}
input,select{background:color-mix(in srgb,var(--cd) 60%,transparent);border-radius:12px}
button.b,label.b{background:linear-gradient(135deg,var(--ac),color-mix(in srgb,var(--ac) 50%,#22d3ee));color:#fff;box-shadow:0 0 18px color-mix(in srgb,var(--ac) 45%,transparent);border-radius:12px}
button.b.s,label.b.s{background:color-mix(in srgb,var(--cd) 70%,transparent);color:var(--tx);border:1px solid var(--ln);box-shadow:none}
label.b{display:block;text-align:center;padding:12px;font-weight:700;cursor:pointer;margin:4px 0}
nav{background:color-mix(in srgb,var(--mn) 88%,transparent);-webkit-backdrop-filter:blur(16px);backdrop-filter:blur(16px);border-top:1px solid color-mix(in srgb,var(--ac) 35%,transparent)}
nav button{color:var(--mt);opacity:.6}nav button.on{opacity:1;color:var(--ac);text-shadow:0 0 12px var(--ac)}
.sl button{background:color-mix(in srgb,var(--cd) 70%,transparent)}.sl button.on{box-shadow:0 0 14px var(--ac)}
.tg{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-top:10px}.tl{padding:12px;border:1px solid var(--ln);border-radius:14px;background:color-mix(in srgb,var(--cd) 60%,transparent)}
.bar{height:8px;border-radius:99px;background:var(--ln);overflow:hidden;margin:6px 0}.bar i{display:block;height:100%;background:linear-gradient(90deg,var(--ac),#22d3ee)}.big{font-size:40px;font-weight:800;line-height:1.2}
.hud{background:linear-gradient(135deg,color-mix(in srgb,var(--ac) 32%,var(--cd)),var(--cd))!important}.bar i{transition:width .6s}
.al{border-left:3px solid var(--ac);padding:6px 10px;margin:8px 0;border-radius:6px;background:color-mix(in srgb,var(--cd) 50%,transparent)}.kp{font-size:26px;font-weight:700;line-height:1.3}
</style></head><body>
<div id="toast"></div><header id="hd"></header><main id="app"></main><nav id="nv"></nav>
<script>
const K="salonpro_v2",E=s=>String(s??"").replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const D={shop:{name:"ร้านของฉัน",logo:"",lat:"",lng:"",pp:"",bank:"",bno:"",bnm:"",idnm:"",kyc:"",plan:"std",line:false,auto:60,dep:30,minOn:300,tf:100},
zones:[{km:3,fee:60},{km:7,fee:120},{km:12,fee:200}],
services:[{id:1,name:"ตัดผมชาย",price:150,min:30},{id:2,name:"สระ-ไดร์",price:200,min:30},{id:3,name:"ตัดผมหญิง",price:300,min:45}],
staff:[{id:1,name:"ช่างเอ",pct:50},{id:2,name:"ช่างบี",pct:40}],bookings:[],pts:{}};
let S;try{S=JSON.parse(localStorage.getItem(K))||D}catch(e){S=D}
const save=()=>{try{localStorage.setItem(K,JSON.stringify(S))}catch(e){}};
const today=new Date().toISOString().slice(0,10);
let tab="book",cs=1,tkv="",ck=false,im={id:"",bk:"",menu:""},bk={svc:1,staff:1,date:today,time:"",mode:"shop",qty:1,pay:"cash",name:"",phone:"",addr:""};
const sv=i=>S.services.find(x=>x.id==i)||{name:"-",price:0,min:30},st=i=>S.staff.find(x=>x.id==i)||{name:"-",pct:0};
const slots=[];for(let h=9;h<20;h++){slots.push(h+":00");slots.push(h+":30")}
const hav=(a,b,c,d)=>{const r=x=>x*Math.PI/180,q=Math.sin(r(c-a)/2)**2+Math.cos(r(a))*Math.cos(r(c))*Math.sin(r(d-b)/2)**2;return 12742*Math.asin(Math.sqrt(q))};
const h=s=>{let x=7;for(const c of s)x=(x*31+c.charCodeAt(0))%1000003;return x};
const tok=p=>{const b=Math.floor(Date.now()/60000);return p+"."+b+"."+h(p+b)};
const toast=t=>{const e=document.getElementById("toast");e.textContent="💬 LINE: "+t;e.style.display="block";setTimeout(()=>e.style.display="none",3800)};
const crc=s=>{let c=65535;for(const ch of s){c^=ch.charCodeAt(0)<<8;for(let i=0;i<8;i++)c=c&32768?((c<<1)^4129):(c<<1);c&=65535}return c.toString(16).toUpperCase().padStart(4,"0")};
function ppay(id,a){id=id.replace(/\D/g,"");const t=id.length>=13?"02":"01",v=t=="01"?"0066"+id.slice(1):id,f=(k,x)=>k+String(x.length).padStart(2,"0")+x;
const p=f("00","01")+f("01","12")+f("29",f("00","A000000677010111")+f(t,v))+f("53","764")+f("54",a.toFixed(2))+f("58","TH")+"6304";return p+crc(p)}
function qr(id,t){setTimeout(()=>{const e=document.getElementById(id);if(e&&window.QRCode){e.innerHTML="";new QRCode(e,{text:t,width:190,height:190})}},40)}
function qt(){const s=sv(bk.svc),sub=s.price*bk.qty;let km=0,fee=0,err="";
if(bk.mode=="home"){if(!bk.lat||!S.shop.lat)err="ปักหมุดที่อยู่ก่อน (และร้านต้องตั้งพิกัด)";else{km=hav(+S.shop.lat,+S.shop.lng,bk.lat,bk.lng)*1.3;const z=S.zones.slice().sort((a,b)=>a.km-b.km).find(z=>km<=z.km);if(!z)err="อยู่นอกพื้นที่บริการ ("+km.toFixed(1)+" กม.)";else fee=z.fee;if(!err&&sub<S.shop.minOn)err="ขั้นต่ำนอกสถานที่ ฿"+S.shop.minOn+" (เพิ่มจำนวนคนหรือบริการ)"}}
const tm=Math.round(km*3+5),total=sub+fee;return{sub,km,fee,err,total,dep:bk.mode=="home"?Math.round(total*S.shop.dep/100):0,dur:s.min*bk.qty+(bk.mode=="home"?2*tm:0)}}
function blocked(sid,date,t,dur){const i=slots.indexOf(t),need=Math.ceil(dur/30);if(i+need>slots.length)return true;const u=new Set();
S.bookings.filter(b=>b.staff==sid&&b.date==date&&b.status!="cancel").forEach(b=>{const j=slots.indexOf(b.time);for(let k=0;k<Math.ceil(b.dur/30);k++)u.add(j+k)});
for(let k=0;k<need;k++)if(u.has(i+k))return true;return false}
const T=[["book","จองคิว"],["me","QR ฉัน"],["tech","ช่าง"],["walk","Walk-in"],["hq","HQ"],["shop","ตั้งค่า"],["plan","แพ็กเกจ"]];
function head(){hd.innerHTML=(S.shop.logo?`<img src="${S.shop.logo}">`:"<img alt=''>")+`<div><h1>${E(S.shop.name)} ${S.shop.kyc=="ok"?'<span class="tag ok">✔ ยืนยันแล้ว</span>':""}</h1>${S.shop.lat?`<a class="mu" target="_blank" href="https://maps.google.com/?q=${E(S.shop.lat)},${E(S.shop.lng)}">📍 แผนที่ร้าน</a>`:'<span class="mu">จองผ่าน LINE</span>'}</div>`;
nv.innerHTML=T.map(([k,n])=>`<button class="${tab==k?"on":""}" onclick="tab='${k}';draw()">${n}</button>`).join("")}
function vBook(){const q=qt(),home=bk.mode=="home",trOk=S.shop.kyc=="ok";
return banner()+`<div class="c"><h2>จองคิว${S.shop.open===false?' <span class="wr">(ปิดรับชั่วคราว)</span>':""}</h2><div class="r"><button class="b ${home?"s":""}" onclick="bk.mode='shop';bk.time='';draw()">🏪 ที่ร้าน</button><button class="b ${home?"":"s"}" ${S.shop.homeOn===false?"disabled":""} onclick="bk.mode='home';bk.time='';draw()">🏠 ช่างไปหาที่บ้าน${S.shop.homeOn===false?" (ปิดรับ)":""}</button></div>
<select onchange="bk.svc=this.value;bk.time='';draw()">${S.services.map(s=>`<option value="${s.id}" ${s.id==bk.svc?"selected":""}>${E(s.name)} ฿${s.price} (${s.min} นาที)</option>`).join("")}</select>
${staffPick()}<div class="r"><select onchange="bk.qty=+this.value;bk.time='';draw()">${[1,2,3,4,5].map(n=>`<option ${n==bk.qty?"selected":""} value="${n}">${n} คน</option>`).join("")}</select></div>
${home?`<button class="b s" onclick="pin()">📍 ใช้ตำแหน่งปัจจุบันเป็นที่อยู่</button><input placeholder="ที่อยู่/จุดสังเกต" value="${E(bk.addr)}" oninput="bk.addr=this.value">`:""}
${stylePick()}<input type="date" min="${today}" value="${bk.date}" onchange="bk.date=this.value;bk.time='';draw()">
<div class="sl">${slots.map(t=>`<button ${blocked(bk.staff,bk.date,t,q.dur)?"disabled":""} class="${bk.time==t?"on":""}" onclick="bk.time='${t}';draw()">${t}</button>`).join("")}</div>
<input placeholder="ชื่อ" value="${E(bk.name)}" oninput="bk.name=this.value"><input type="tel" placeholder="เบอร์โทร" value="${E(bk.phone)}" oninput="bk.phone=this.value">
<div class="r"><button class="b ${bk.pay=="cash"?"":"s"}" onclick="bk.pay='cash';draw()">💵 เงินสด</button><button class="b ${bk.pay=="tr"?"":"s"}" ${trOk?"":"disabled"} onclick="bk.pay='tr';draw()">📲 โอน</button></div>
${trOk?"":'<div class="mu">ร้านยังไม่ผ่านการยืนยันบัญชี จึงรับเฉพาะเงินสด</div>'}
<div style="margin:8px 0;padding:10px;border:1px dashed var(--ln);border-radius:10px">บริการ ฿${q.sub}${home?`<br>ค่าเดินทาง ${q.km.toFixed(1)} กม. ฿${q.fee}<br>มัดจำ (${S.shop.dep}%) ฿${q.dep}`:""}<br><b>รวม ฿${q.total}</b> · ใช้เวลา ~${q.dur} นาที${q.err?`<br><span class="wr">${q.err}</span>`:""}</div>
<button class="b" ${q.err?"disabled":""} onclick="book()">ยืนยันจอง</button></div>`}
function pin(){navigator.geolocation?navigator.geolocation.getCurrentPosition(p=>{bk.lat=p.coords.latitude;bk.lng=p.coords.longitude;bk.time="";draw()},()=>toast("อ่านตำแหน่งไม่ได้")):0}
function book(){if(S.shop.open===false)return toast("ร้านปิดรับจองชั่วคราว");if(S.shop.homeOn===false&&bk.mode=="home")return toast("ปิดรับงานถึงบ้านชั่วคราว");const q=qt();if(!bk.time||!bk.name||!bk.phone)return toast("เลือกเวลา และกรอกชื่อ/เบอร์");
const pay=bk.pay=="tr"&&S.shop.kyc!="ok"?"cash":bk.pay;S.bookings.push({id:Date.now(),svc:+bk.svc,staff:+bk.staff,date:bk.date,time:bk.time,name:bk.name,phone:bk.phone,mode:bk.mode,qty:bk.qty,km:q.km,fee:q.fee,sub:q.sub,total:q.total,dep:pay=="tr"?q.dep:0,depPaid:false,dur:q.dur,pay,status:"wait",paid:false,addr:bk.addr,style:((S.styles||DS).find(x=>x.id==bk.style)||{}).name||"",sImg:bk.ref||((S.styles||DS).find(x=>x.id==bk.style)||{}).img||"",note:bk.note||""});save();
toast(`ยืนยันคิว ${bk.date} ${bk.time} ถึงลูกค้าและ${st(bk.staff).name}`);bk.time="";bk.style=bk.ref=bk.note="";draw()}
function vMe(){const ok=/^0\d{8,9}$/.test(bk.phone.replace(/\D/g,""));const l=S.bookings.filter(b=>b.phone==bk.phone&&b.status!="cancel");
if(ok)qr("mq",tok(bk.phone));return `<div class="c"><h2>QR ประจำตัวลูกค้า</h2><input type="tel" placeholder="เบอร์โทรที่ใช้จอง" value="${E(bk.phone)}" oninput="bk.phone=this.value;if(/^0\\d{8,9}$/.test(this.value))draw()">
${ok?`<div class="q"><div id="mq"></div></div><p class="mu">ให้ช่างสแกนเมื่อถึงตัว · รหัสเปลี่ยนทุก 1 นาที กันการถ่ายรูปไปใช้ซ้ำ</p><input readonly value="${tok(bk.phone)}">`:'<p class="mu">กรอกเบอร์เพื่อสร้าง QR</p>'}</div>
<div class="c"><h2>คิวของฉัน</h2>${l.length?l.map(b=>`<div style="padding:6px 0;border-bottom:1px solid var(--ln)"><b>${b.date} ${b.time}</b> ${E(sv(b.svc).name)} ${b.mode=="home"?"🏠":"🏪"} ฿${b.total} <span class="tag">${lb(b)}</span>
${!b.paid&&b.status!="done"?`<div class="r"><button class="b ${b.pay=="cash"?"":"s"}" onclick="setPay(${b.id},'cash')">เงินสด</button><button class="b ${b.pay=="tr"?"":"s"}" ${S.shop.kyc=="ok"?"":"disabled"} onclick="setPay(${b.id},'tr')">โอน</button></div>`:""}${b.paid?rateBox(b):""}</div>`).join(""):'<p class="mu">ไม่พบคิว</p>'}</div>`}
function setPay(i,m){S.bookings.find(b=>b.id==i).pay=m;save();draw()}
const lb=b=>b.status=="wait"?"รอคิว":b.status=="travel"?"ช่างกำลังเดินทาง":b.status=="serving"?"กำลังให้บริการ":b.status=="closed"?(b.paid?"เสร็จ":"จบงาน-รอรับเงิน"):b.status=="done"?"เสร็จสมบูรณ์":"-";
function closeJob(b,why){b.status="closed";b.t1=Date.now();toast(`ปิดงาน ${b.name} (${why}) - รอยืนยันรับเงิน`)}
function scan(){const t=tkv.trim().split(".");if(t.length!=3)return toast("QR ไม่ถูกต้อง");const n=Math.floor(Date.now()/60000);
if(+t[2]!=h(t[0]+t[1])||n-t[1]>1||n-t[1]<0)return toast("QR หมดอายุ ให้ลูกค้ารีเฟรช");
const j=S.bookings.filter(x=>x.staff==cs&&x.phone==t[0]&&["wait","travel"].includes(x.status)).sort((a,b)=>(a.date+a.time).localeCompare(b.date+b.time))[0];
if(!j)return toast("ไม่พบคิวของลูกค้าคนนี้กับช่างคนนี้");
S.bookings.filter(x=>x.staff==cs&&x.status=="serving").forEach(x=>closeJob(x,"สแกนงานใหม่"));j.status="serving";j.t0=Date.now();tkv="";save();toast(`เริ่มงาน ${j.name}`);draw()}
function vTech(){const me=S.staff.find(x=>x.id==cs)||{pct:0},mine=S.bookings.filter(b=>b.staff==cs&&b.status!="cancel"),dn=mine.filter(b=>(b.date==today||b.time=="walk")&&b.paid),
inc=dn.reduce((a,b)=>a+(b.total-b.fee)*me.pct/100+b.fee*S.shop.tf/100,0),l=mine.filter(b=>b.status!="done").sort((a,b)=>(a.date+a.time).localeCompare(b.date+b.time)),a=l.find(b=>b.status=="serving"),rest=l.filter(b=>b.status!="serving"),
nw=rest.filter(b=>b.status=="wait"||b.status=="travel").length,cl=rest.filter(b=>b.status=="closed"&&!b.paid).length;
const tile=(n,v,c)=>`<div class="tl"><div class="mu">${n}</div><b style="font-size:24px;${c||""}">${v}</b></div>`;
const row=b=>`<div style="padding:10px 0;border-bottom:1px solid var(--ln)"><div class="r"><b class="f">${b.time=="walk"?"Walk-in":b.time}</b><span>${E(b.name)} ${b.mode=="home"?"🏠":b.mode=="walk"?"🚶":"🏪"}</span><span class="tag f">${lb(b)}</span></div><div class="mu">${E(b.lbl||sv(b.svc).name+" ×"+b.qty)} · ฿${b.total} · ${b.pay=="tr"?"โอน":"เงินสด"}${b.addr?" · "+E(b.addr):""}</div>${b.style||b.note?`<div style="margin-top:4px">✂️ <b>${E(b.style||"ไม่ระบุทรง")}</b>${b.note?" · "+E(b.note):""}</div>`:""}${b.sImg?`<img src="${b.sImg}" style="width:100%;max-height:180px;object-fit:cover;border-radius:10px;margin-top:4px">`:""}
